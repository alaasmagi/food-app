# Copy this file to .env for local development and fill in real values.

# Application HTTP port inside container/process (used to build ASPNETCORE_URLS when not set explicitly).
APP_PORT=8080

# Platform-provided port fallback used when APP_PORT is not set.
PORT=8080

# Optional explicit ASP.NET Core binding. When set, this overrides APP_PORT/PORT-derived binding.
ASPNETCORE_URLS=http://+:8080

# Optional host port mapping for docker compose deployments.
HOST_PORT=8080

# PostgreSQL connection used by AppDbContext.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=app;Username=app_user;Password=change-me;Search Path=app

# Redis cache connection and default cache behavior.
REDIS_CONNECTION_STRING=localhost:6379
CACHE_KEY_PREFIX=app-service
CACHE_DEFAULT_ABSOLUTE_EXPIRATION_SECONDS=300

# RabbitMQ. Topology (exchanges, queues, bindings, permissions) is provisioned on the broker; this
# service never declares any of it.
#
# APP_EVENT_SOURCE is the single registry value: the envelope source and tenant, the first routing-key
# segment, the broker username (must equal the user in RABBITMQ_URI), the broker write-permission
# prefix (^<source>\.), and the Keycloak realm. They must all match or the broker refuses the publish;
# startup validates APP_EVENT_SOURCE == the RABBITMQ_URI username.
RABBITMQ_URI=amqps://food-app:password@message.example.com:5671
APP_EVENT_SOURCE=food-app
# Publishing exchange for email commands (email-hub owns it). Set to whatever the broker provisions
# for this platform (e.g. email-hub.commands).
RABBITMQ_EXCHANGE=email.commands
# The identity-hub user-events queue this service consumes (provisioned on the broker).
RABBITMQ_QUEUE=food-app
# Optional. Bounded wait for a publisher confirm; an unconfirmed publish is treated as failed.
# RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_SECONDS=10

# Glitchtip/Sentry-compatible error and log reporting.
GLITCHTIP_DSN=https://examplePublicKey@glitchtip.example.com/1
GLITCHTIP_RELEASE=app-service

# API rate limiting.
RATE_LIMIT_PERMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_QUEUE_LIMIT=0

# Keycloak authentication.
KEYCLOAK_AUTHORITY=https://identity.alaasmagi.dev/realms/app-service
KEYCLOAK_CLIENT_ID=app-service
KEYCLOAK_CLIENT_SECRET=change-me

# Exact origin of the Vue frontend, used for the credentialed CORS policy on the /account/* endpoints.
FRONTEND_ORIGIN=https://app.alaasmagi.dev

# Daily lunch-recommendation batch. Runs on a wall-clock schedule in the given IANA timezone (not the
# host's local time); the same timezone anchors the offer windows, message expiration, and the
# per-recipient send date. All optional — shown with their defaults.
# DAILY_RECOMMENDATION_RUN_TIME=08:00
# DAILY_RECOMMENDATION_TIME_ZONE=Europe/Tallinn
# DAILY_RECOMMENDATION_CURRENCY=EUR
# Links in the mail are this service's own URLs (never Keycloak action-token URLs).
# DAILY_RECOMMENDATION_APP_BASE_URL=https://app.example.com
# DAILY_RECOMMENDATION_RESTAURANT_PATH_TEMPLATE=/restaurants/{restaurantId}
# DAILY_RECOMMENDATION_WHEEL_PATH=/wheel
