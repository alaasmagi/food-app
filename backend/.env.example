# Copy this file to .env for local development and fill in real values.

# Application HTTP port inside container/process (used to build ASPNETCORE_URLS when not set explicitly).
APP_PORT=

# Platform-provided port fallback used when APP_PORT is not set.
PORT=

# Optional explicit ASP.NET Core binding. When set, this overrides APP_PORT/PORT-derived binding.
ASPNETCORE_URLS=

# Optional host port mapping for docker compose deployments.
HOST_PORT=

# PostgreSQL connection used by AppDbContext.
DATABASE_CONNECTION_STRING=

# Redis cache connection and default cache behavior.
REDIS_CONNECTION_STRING=
CACHE_KEY_PREFIX=
CACHE_DEFAULT_ABSOLUTE_EXPIRATION_SECONDS=

# Optional SQLite offer cache. Empty uses the appsettings OfferCache values.
OFFER_CACHE_CONNECTION_STRING=
OFFER_CACHE_TTL_SECONDS=

# RabbitMQ. Topology (exchanges, queues, bindings, permissions) is provisioned on the broker; this
# service never declares any of it.
#
# APP_EVENT_SOURCE is the envelope source and tenant and the first routing-key segment. It must match
# the broker username in RABBITMQ_URI, the broker write-permission prefix and the Keycloak realm.
RABBITMQ_URI=
APP_EVENT_SOURCE=
APP_SLUG=
# Publishing exchange for email commands (email-hub owns it).
RABBITMQ_EXCHANGE=
# The identity-hub user-events queue this service consumes (provisioned on the broker).
RABBITMQ_QUEUE=
# Optional. Bounded wait for a publisher confirm; an unconfirmed publish is treated as failed.
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_SECONDS=

# Glitchtip/Sentry-compatible error and log reporting.
GLITCHTIP_DSN=
GLITCHTIP_RELEASE=

# API rate limiting.
RATE_LIMIT_PERMIT_LIMIT=
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_QUEUE_LIMIT=

# Optional. Rate limiting for the anonymous public wheel endpoint (per client IP).
PUBLIC_RATE_LIMIT_PERMIT_LIMIT=
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=
PUBLIC_RATE_LIMIT_QUEUE_LIMIT=

# Keycloak authentication.
KEYCLOAK_AUTHORITY=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Exact origin of the Vue frontend, allowed by the CORS policy.
FRONTEND_ORIGIN=

# Daily lunch-recommendation batch, scheduled in the given IANA timezone. All optional; empty uses the
# built-in default. Mail links are this service's own URLs (never Keycloak action-token URLs).
DAILY_RECOMMENDATION_RUN_TIME=
DAILY_RECOMMENDATION_TIME_ZONE=
DAILY_RECOMMENDATION_CURRENCY=
DAILY_RECOMMENDATION_APP_BASE_URL=
DAILY_RECOMMENDATION_RESTAURANT_PATH_TEMPLATE=
DAILY_RECOMMENDATION_WHEEL_PATH=
